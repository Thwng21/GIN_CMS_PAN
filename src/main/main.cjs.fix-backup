const { app, BrowserWindow, WebContentsView, ipcMain } = require('electron')
const path = require('path')

const isDev = !app.isPackaged

let win
let browserView = null
let browserVisible = false

function createWindow() {
  win = new BrowserWindow({
    width: 1440,
    height: 900,
    minWidth: 1100,
    minHeight: 700,
    title: 'SHD Tools V2',
    backgroundColor: '#0f1117',
    webPreferences: {
      preload: path.join(__dirname, 'preload.cjs'),
      contextIsolation: true,
      nodeIntegration: false,
    },
  })

  if (isDev) {
    win.loadURL('http://localhost:5173')
  } else {
    win.loadFile(path.join(__dirname, '../../dist/index.html'))
  }

  win.on('resize', resizeBrowser)
  win.on('closed', () => {
    win = null
    browserView = null
  })
}

function resizeBrowser() {
  if (!win || !browserView || !browserVisible) return

  const [width, height] = win.getContentSize()
  const left = Math.floor(width * 0.38)
  const top = 125

  browserView.setBounds({
    x: left,
    y: top,
    width: Math.max(0, width - left),
    height: Math.max(0, height - top),
  })
}

function isAllowedUrl(value) {
  try {
    const url = new URL(value)
    return url.protocol === 'https:' || url.protocol === 'http:'
  } catch {
    return false
  }
}

function ensureBrowser() {
  if (browserView) return

  browserView = new WebContentsView({
    webPreferences: {
      contextIsolation: true,
      nodeIntegration: false,
      sandbox: true,
    },
  })

  win.contentView.addChildView(browserView)

  const sendUrl = (_event, url) => {
    if (win && !win.isDestroyed()) {
      win.webContents.send('browser:url-changed', url)
    }
  }

  browserView.webContents.on('did-navigate', sendUrl)
  browserView.webContents.on('did-navigate-in-page', sendUrl)

  browserView.webContents.setWindowOpenHandler(({ url }) => {
    if (isAllowedUrl(url)) {
      browserView.webContents.loadURL(url)
    }
    return { action: 'deny' }
  })
}

ipcMain.handle('browser:open', async (_event, value) => {
  if (!win) throw new Error('Cửa sổ ứng dụng chưa sẵn sàng')
  if (!isAllowedUrl(value)) throw new Error('Chỉ chấp nhận URL HTTP hoặc HTTPS')

  ensureBrowser()
  browserVisible = true
  resizeBrowser()

  await browserView.webContents.loadURL(value)
  return { ok: true, url: browserView.webContents.getURL() }
})

ipcMain.handle('browser:show', () => {
  if (!win) return { ok: false }
  ensureBrowser()
  browserVisible = true
  resizeBrowser()
  return { ok: true }
})

ipcMain.handle('browser:hide', () => {
  browserVisible = false
  if (browserView) {
    browserView.setBounds({ x: 0, y: 0, width: 0, height: 0 })
  }
  return { ok: true }
})

ipcMain.handle('browser:back', () => {
  if (browserView?.webContents.canGoBack()) browserView.webContents.goBack()
  return { ok: true }
})

ipcMain.handle('browser:forward', () => {
  if (browserView?.webContents.canGoForward()) browserView.webContents.goForward()
  return { ok: true }
})

ipcMain.handle('browser:reload', () => {
  browserView?.webContents.reload()
  return { ok: true }
})

ipcMain.handle('browser:get-url', () => {
  return browserView?.webContents.getURL() || ''
})

app.whenReady().then(() => {
  createWindow()

  app.on('activate', () => {
    if (BrowserWindow.getAllWindows().length === 0) createWindow()
  })
})

app.on('window-all-closed', () => {
  if (process.platform !== 'darwin') app.quit()
})
